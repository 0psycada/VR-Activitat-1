  instructionsPanel: {fileID: 4710592964363012888}
  scanningPanel: {fileID: 6862272286568978368}
  placingPanel: {fileID: 583604694137057126}
  hudPanel: {fileID: 3039453843599573820}
  endPanel: {fileID: 6835590384285534031}
  instructionsText: {fileID: 113095240373064118}
  instructionsOkButton: {fileID: 2410171014152157460}
  instructions: 'GOAL: grow 3 flowers to full bloom.


    1. Scan the floor until
    you see the grid.

    2. Tap to place the garden. Drag to move it, pinch to
    resize or twist with two fingers to rotate. Then press Start.

    3. Tap a plant
    to water it. The bar above each plant shows the water it has. Tapping a full
    plant hurts it.

    4. Tap the bugs to kill them before they eat your plants.

    5.
    If a plant dies, tap it to replant it. If you lose 3 plants it''s game over.'
  scanningText: {fileID: 1603620395388565370}
  unsupportedMessage: This device does not support ARCore. Garden Keeper needs an
    ARCore-compatible Android phone.
  confirmPlacementButton: {fileID: 6734932632833940906}
  rescanButton: {fileID: 5829587748968795926}
